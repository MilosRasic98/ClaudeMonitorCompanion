#pragma once

// Copy this file to include/secrets.h and fill it in. secrets.h is gitignored
// and is the only place credentials live.

#define WIFI_SSID "your-network"
#define WIFI_PASS "your-password"

// Shared secret the hooks send as `Authorization: Bearer <token>`. Any random
// string will do — this only has to stop other things on the LAN from driving
// the face, not resist a determined attacker.
#define NOTIFY_TOKEN "change-me"

// Advertised over mDNS as <MDNS_NAME>.local. Resolves on macOS. Windows cannot
// generally resolve .local without Bonjour, so the Windows hook config should
// use the board's IP directly — give it a DHCP reservation.
#define MDNS_NAME "claude-notifier"
